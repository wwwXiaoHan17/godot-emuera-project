; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotEmueraProject"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Era="*res://scripts/engine/era.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://assets/": "blue",
"res://docs/": "green",
"res://resources/": "red",
"res://scenes/": "red",
"res://scripts/": "red",
"res://scripts/content/": "red",
"res://scripts/engine/": "red",
"res://tests/": "gray",
"res://tools/": "gray"
}

[gui]

common/auto_focus_strategy=1
theme/custom="uid://dpt7inruqxel2"

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true
